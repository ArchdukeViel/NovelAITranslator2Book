{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Pyright Typecheck",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pyright.ps1"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Run Tests",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pytest.ps1"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Test Watch",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/watchfiles.exe",
      "args": [
        "--filter",
        "python",
        "--target-type",
        "command",
        "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pytest.ps1",
        "backend/src",
        "backend/tests"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "backend-tests",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Ruff Lint & Format",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/ruff.ps1", "check", "."],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Pytest Focused",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/pytest.ps1",
        "${input:backendTestPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Typecheck",
      "type": "shell",
      "command": "npm",
      "args": ["--prefix", "frontend", "run", "typecheck"],
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Run Tests",
      "type": "shell",
      "command": "npm",
      "args": ["--prefix", "frontend", "run", "test"],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Graphify: Update Index",
      "type": "shell",
      "command": "graphify",
      "args": ["update", ".", "--no-cluster"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "backendTestPath",
      "type": "promptString",
      "description": "Backend test path (relative to the workspace)",
      "default": "backend/tests/test_health_api.py"
    }
  ]
}
