{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "installCommand": "pip install uv && uv pip install --system --locked --requirement requirements.lock",
      "functions": {
        "vercel_app.py": {
          "maxDuration": 300,
          "excludeFiles": "{backend/tests/**,frontend/**,deploy/**,docs/**,graphify-out/**,.agents/**,.codex/**,.github/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/metrics",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
