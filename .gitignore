*.py[cod]
*.pyo
*$py.class
*.so
.python-version

# Packaging / build
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
.venv313-backup/
venv/
env/
ENV/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.playwright-cli/
.vercel/
.local/

# Graphify generated knowledge graph
graphify-out/

# CodeGraph generated local index
.codegraph/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.next-dev/
frontend/out/
frontend/coverage/
frontend/*.tsbuildinfo
*.tsbuildinfo
frontend/.env.local
frontend/.env.*.local
.turbo/
.eslintcache
.cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Test / temp artifacts
tests_tmp/
pytest-cache-files-*/
tmp/
.temp/
.tmp/
*.tmp
backend/tests/.tmp/
backend/tests/.cache/
backend/tests/.pytest_cache/
.hypothesis/

# IDE / editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.directory
.Trash-*
__MACOSX/

# Local env / secrets
.env
.env.*
!.env.example
!.env.*.example

# Runtime data
data/runtime/
novel_library/
storage/novel_library/
storage/output/
storage/input/
storage/logs/
storage_backups/
output/
input/
logs/
*.log
backups/
storage/backups/
*.bak
*.backup
*.orig
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Session exports
SESSION_EXPORT_*.json

# Agent working directory (Hermes plans/scratch live here; promote keepers to docs/)
.opencode/
.codex/plans/
.codex/scratch/
.codex/*.log


# Documentation (tracking)
# Note: All .md files are tracked in git for documentation history
# docs/history/ contains archived phase completion and review docs
# These are intentionally committed for project memory and version history

# Node dependencies
node_modules/
frontend/node_modules/

# GitGuardian local scan cache
.cache_ggshield
