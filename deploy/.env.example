# Novel AI configuration
# Profile: Docker Compose development
# Copy this file to deploy/.env and replace placeholders as needed.
# Never commit real credentials or secrets.
#
# Complete variable reference: docs/CONFIGURATION.md

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Supported values: development, production
ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Compose host path for disposable runtime state during local development.
RUNTIME_HOST_DIR=../data/runtime
RUNTIME_DIR=/app/data/runtime
R2_BUCKET=dokushodo
R2_GATEWAY_URL=https://r2-gateway.example.com
R2_GATEWAY_CLIENT_ID=application-access-client-id
R2_GATEWAY_CLIENT_SECRET=application-access-client-secret
R2_STORAGE_LIMIT_GB=9.5

# ---------------------------------------------------------------------------
# Object snapshots
# ---------------------------------------------------------------------------
R2_BACKUP_PREFIX=snapshots

BACKUP_ENABLED=false
R2_BACKUP_ENABLED=false
R2_BACKUP_BUCKET=dokushodo-backup
R2_RECOVERY_GATEWAY_URL=https://r2-gateway.example.com
R2_RECOVERY_CLIENT_ID=recovery-access-client-id
R2_RECOVERY_CLIENT_SECRET=recovery-access-client-secret

# ---------------------------------------------------------------------------
# Isolated R2 integration tests (optional; never production)
# ---------------------------------------------------------------------------

# Test integration settings target only a separately deployed test Worker.
# TEST_R2_GATEWAY_URL=https://test-r2-gateway.example.com
# TEST_R2_BUCKET=test-dokushodo
# TEST_R2_BACKUP_BUCKET=test-dokushodo-backup
# TEST_R2_APP_CLIENT_ID=test-application-client-id
# TEST_R2_APP_CLIENT_SECRET=test-application-client-secret
# TEST_R2_RECOVERY_CLIENT_ID=test-recovery-client-id
# TEST_R2_RECOVERY_CLIENT_SECRET=test-recovery-client-secret

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL URL format:
# postgresql+psycopg://user:password@host:5432/database
DATABASE_URL=postgresql+psycopg://user:password@database-host:5432/novelai
MIGRATION_DATABASE_URL=postgresql+psycopg://migration-role:password@database-host:5432/novelai
DB_CONNECTION_MODE=direct
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PROCESS_COUNT=3
DB_CONNECTION_RESERVE=2
DB_CONNECTION_BUDGET=32
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SSL_MODE=prefer
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Database backup and restore verification
# ---------------------------------------------------------------------------

DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_SCHEDULE_CRON=0 1 * * *
DATABASE_BACKUP_TIMEZONE=UTC
DATABASE_BACKUP_PREFIX=database
DATABASE_BACKUP_RETENTION_DAYS=30
DATABASE_BACKUP_MIN_SUCCESSFUL_TO_KEEP=3
DATABASE_BACKUP_ENCRYPTION_KEY=replace-with-a-dedicated-secret
DATABASE_BACKUP_URL=postgresql+psycopg://backup-role:password@database-host:5432/novelai
DATABASE_RESTORE_VERIFICATION_ENABLED=false
DATABASE_RESTORE_VERIFICATION_SCHEDULE_CRON=0 3 1 * *
DATABASE_RESTORE_VERIFICATION_TIMEZONE=UTC
DATABASE_RESTORE_VERIFICATION_MAX_AGE_DAYS=32
DATABASE_RESTORE_TARGET_URL=postgresql+psycopg://user:password@database-host:5432/novelai_restore_verify
DATABASE_RESTORE_SSL_MODE=prefer
DATABASE_RESTORE_PASSWORD=replace-with-a-dedicated-local-restore-password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# Public ranking cache (short-lived, successful results only)
PUBLIC_RANKING_CACHE_ENABLED=true
PUBLIC_RANKING_CACHE_TTL_SECONDS=60
PUBLIC_RANKING_CACHE_MAX_ENTRIES=64
PUBLIC_PROJECTION_CACHE_ENABLED=true
PUBLIC_PROJECTION_CACHE_TTL_SECONDS=30
PUBLIC_PROJECTION_CACHE_MAX_ENTRIES=256

# Readiness and analytics backpressure
HEALTH_PROBE_TIMEOUT_MS=1000
HEALTH_TOTAL_TIMEOUT_MS=3000
HEALTH_CACHE_TTL_SECONDS=5
ANALYTICS_ASYNC_QUEUE_SIZE=1000

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
BACKEND_API_HOST=localhost

WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_CORS_ORIGINS=http://localhost:3000
WEB_RATE_LIMITER_BACKEND=memory
WEB_REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Session and authentication
# ---------------------------------------------------------------------------

# Generate secrets with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace-with-a-strong-random-secret
OWNER_BOOTSTRAP_SECRET=replace-with-a-different-strong-random-secret
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=false
PUBLIC_FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Auth email delivery
# ---------------------------------------------------------------------------

AUTH_EMAIL_DELIVERY_MODE=noop
AUTH_PASSWORD_RESET_PATH=/password/reset
AUTH_EMAIL_VERIFICATION_PATH=/email/verify
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=your-smtp-username
#SMTP_PASSWORD=your-smtp-password
#SMTP_FROM_EMAIL=noreply@yourdomain.com
#SMTP_FROM_NAME=Dokushodo
#SMTP_STARTTLS=true
#SMTP_USE_SSL=false
#SMTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Translation providers
# ---------------------------------------------------------------------------

PROVIDER_DEFAULT=gemini
PROVIDER_GEMINI_API_KEY=your-google-ai-studio-api-key
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-local-secret
PROVIDER_GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
PROVIDER_GEMINI_MODEL_FALLBACKS=[]
TRANSLATION_TARGET_LANGUAGE=English
TRANSLATION_PROVIDER_DEADLINE_SECONDS=600
TRANSLATION_PROVIDER_RETRY_BACKOFF_BASE_SECONDS=1
TRANSLATION_PROVIDER_RETRY_BACKOFF_MAX_SECONDS=30
TRANSLATION_CONCURRENCY=4
TRANSLATION_PERSISTENCE_EXPANSION_ENABLED=false
TRANSLATION_PERSISTENCE_WORKERS=2
TRANSLATION_PERSISTENCE_QUEUE_SIZE=8
TRANSLATION_PERSISTENCE_OBSERVATION_LIMIT=256
TRANSLATION_PERSISTENCE_SHUTDOWN_TIMEOUT_SECONDS=30
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=500
GEMINI_CONCURRENCY_LIMIT=4
CONTRIBUTOR_CREDENTIALS_ENABLED=true
CONTRIBUTOR_CONSENT_VERSION=2026-08-19
CONTRIBUTOR_RPM_LIMIT=15
CONTRIBUTOR_TPM_LIMIT=250000
CONTRIBUTOR_RPD_LIMIT=500
CONTRIBUTOR_CONCURRENCY_LIMIT=2
PROVIDER_RESERVATION_TTL_SECONDS=900
ACTIVITY_HISTORY_MAX_ENTRIES=10000
ACTIVITY_METADATA_MAX_BYTES=256000
ACTIVITY_RETRY_HISTORY_MAX_ENTRIES=100

# ---------------------------------------------------------------------------
# Jobs and scheduling
# ---------------------------------------------------------------------------

JOB_WORKER_ENABLED=false
JOB_WORKER_POLL_SECONDS=3
RUNTIME_TELEMETRY_SAMPLE_INTERVAL_SECONDS=0.25
RUNTIME_TELEMETRY_MAX_OBSERVATIONS=256
RUNTIME_EVENT_LOOP_LAG_THRESHOLD_MS=1000
SCHEDULED_JOB_LEASE_SECONDS=900

# ---------------------------------------------------------------------------
# Operator alerts
# ---------------------------------------------------------------------------

OPERATOR_ALERT_ENABLED=false
#OPERATOR_ALERT_EMAIL=ops@example.com
OPERATOR_ALERT_FAILURE_THRESHOLD=3
OPERATOR_ALERT_COOLDOWN_SECONDS=3600
OPERATOR_ALERT_STALE_BACKUP_HOURS=36

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

VERSION=local
DEPLOY_MODE=monolith
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXY_CIDRS=
HEALTH_DISK_WARNING_FREE_PERCENT=15
HEALTH_DISK_CRITICAL_FREE_PERCENT=5
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_TIMEZONE=UTC
BACKUP_RETENTION_COUNT=5
BACKUP_MIN_SUCCESSFUL_TO_KEEP=3
BACKUP_MAX_AGE_DAYS=30
BACKUP_SAFETY_GRACE_DAYS=7
MAINTENANCE_ENABLED=false
MAINTENANCE_SCHEDULE_CRON=0 3 * * *
MAINTENANCE_DRY_RUN=false
MAINTENANCE_ACTIVITY_RETENTION_DAYS=90
MAINTENANCE_FAILED_ACTIVITY_RETENTION_DAYS=180
MAINTENANCE_FETCH_CACHE_MAX_AGE_HOURS=24
MAINTENANCE_PIPELINE_EVENTS_MAX_AGE_DAYS=30
MAINTENANCE_SCHEDULER_STATE_RETENTION_DAYS=14
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=30
SCHEDULER_STALE_AFTER_SECONDS=120
SCHEDULER_RUNTIME_STATE_TTL_DAYS=14
FILE_LOCK_RETRY_COUNT=10
FILE_LOCK_RETRY_DELAY_SECONDS=0.1

PUBLIC_HTTP_PORT=80
PUBLIC_BIND_ADDRESS=127.0.0.1
SITE_DOMAIN=localhost
